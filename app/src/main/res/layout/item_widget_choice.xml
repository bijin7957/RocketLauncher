<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:paddingEnd="8dp"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetLabel"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/primaryColor"
            tools:text="Weather · Current weather and forecast" />

        <TextView
            android:id="@+id/widgetSize"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:textColor="?attr/primaryColor"
            tools:text="4×2" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetDescription"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.6"
        android:textColor="?attr/primaryColor"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Hourly forecast"
        tools:visibility="visible" />

    <!-- Preview image, or the widget's preview layout, in a fixed height so tall ones stay compact -->
    <FrameLayout
        android:id="@+id/widgetPreview"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="noHideDescendants" />
</LinearLayout>
